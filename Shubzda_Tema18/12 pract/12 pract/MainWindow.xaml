<Window x:Class="_12_pract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организация мероприятий"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">
    
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateEventCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditEventCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DeleteEventCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Storyboard x:Key="FadeInRow">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.5"/>
        </Storyboard>
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="RegisterButtonTemplate" TargetType="Button">
            <Border Background="#4CAF50" CornerRadius="5" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👤" FontSize="16" Margin="0,0,5,0"/>
                    <ContentPresenter/>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="2" VerticalAlignment="Top">
            <MenuItem Header="Файл"/>
            <MenuItem Header="Мероприятия">
                <MenuItem Header="Создать" Command="{Binding CreateEventCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать" Command="{Binding EditEventCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteEventCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,25,0,0">
            <ToolBar>
                <Button Content="Создать" Style="{StaticResource AnimatedButton}" Command="{Binding CreateEventCommand}"/>
                <Button Content="Редактировать" Style="{StaticResource AnimatedButton}" Command="{Binding EditEventCommand}"/>
                <Button Content="Удалить" Style="{StaticResource AnimatedButton}" Command="{Binding DeleteEventCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <Label Content="Организация мероприятий"
               HorizontalAlignment="Center"
               Margin="0,60,0,0"
               FontFamily="Segoe UI Semibold"
               FontSize="28"
               Grid.ColumnSpan="2"/>

        <Calendar Grid.Column="0"
                  Margin="20,120,20,0"
                  VerticalAlignment="Top"
                  SelectedDate="{Binding SelectedEvent.Date, Mode=TwoWay}"
                  Height="180"/>

        <DataGrid Grid.Column="0"
                  Margin="20,310,20,80"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Events}"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" />
                <DataGridTextColumn Header="Участники" Binding="{Binding Participants.Count}" />
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Background" Value="White"/>
                    <EventSetter Event="Loaded" Handler="Row_Loaded"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                        From="White" To="#D1FFD6" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                        To="White" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"/>
                            <TextBlock Text="{Binding Participants.Count, StringFormat='Участников: {0}'}"/>
                            <ItemsControl ItemsSource="{Binding Participants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,20,20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="40">
            <Button Content="Добавить мероприятие"
                    Style="{StaticResource AnimatedButton}"
                    Width="150"
                    Margin="0,0,10,0"
                    Command="{Binding CreateEventCommand}"/>
            <Button Content="Удалить мероприятие"
                    Style="{StaticResource AnimatedButton}"
                    Width="150"
                    Command="{Binding DeleteEventCommand}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,120,10,20">
            <Label Content="Регистрация участников" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="ФИО"/>
            <TextBox Text="{Binding NewParticipant.FullName}" Margin="0,0,0,10"/>
            <TextBlock Text="Email"/>
            <TextBox Text="{Binding NewParticipant.Email}" Margin="0,0,0,10"/>
            <TextBlock Text="Секция"/>
            <TextBox Text="{Binding NewParticipant.Section}" Margin="0,0,0,10"/>
            <Button Content="Добавить участника"
                    Template="{StaticResource RegisterButtonTemplate}"
                    Height="35" Width="160"
                    Margin="0,10,0,0"
                    Command="{Binding RegisterCommand}"/>

            <Label Content="Чат" FontSize="16" FontWeight="Bold" Margin="0,20,0,0"/>
            <ListBox ItemsSource="{Binding ChatMessages}" Height="150"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBox Width="200" Text="{Binding ChatInput}"/>
                <Button Content="Отправить" Width="80" Margin="5,0,0,0"
                        Command="{Binding SendChatCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>