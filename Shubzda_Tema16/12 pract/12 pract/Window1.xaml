<Window x:Class="_12_pract.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="260" Width="350"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" FontWeight="Bold"/>
        <TextBox Grid.Row="1" x:Name="LoginBox" Margin="0,5,0,10"/>

        <TextBlock Grid.Row="2" Text="Пароль" FontWeight="Bold"/>
        <PasswordBox Grid.Row="3" x:Name="PasswordBox" Margin="0,5,0,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Войти" Width="100" Margin="0,0,10,0"
                    Click="Login_Click"/>
            <Button Content="Регистрация" Width="120"
                    Click="Register_Click"/>
        </StackPanel>
    </Grid>
</Window>
