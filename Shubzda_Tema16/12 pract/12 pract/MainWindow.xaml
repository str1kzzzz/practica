<Window x:Class="_12_pract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организация мероприятий"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">


    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateEventCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditEventCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DeleteEventCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ControlTemplate x:Key="RegisterButtonTemplate" TargetType="Button">
            <Border Background="#4CAF50" CornerRadius="5" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👤" FontSize="16" Margin="0,0,5,0"/>
                    <ContentPresenter/>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid Height="546" Width="982">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="413*"/>
            <ColumnDefinition Width="387*"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="2" VerticalAlignment="Top">
            <MenuItem Header="Файл" />
            <MenuItem Header="Мероприятия">
                <MenuItem Header="Создать" Command="{Binding CreateEventCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать" Command="{Binding EditEventCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteEventCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="Участники" />
            <MenuItem Header="Настройки" />
        </Menu>

        <ToolBarTray Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,25,0,0">
            <ToolBar>
                <Button Content="Создать" Command="{Binding CreateEventCommand}"/>
                <Button Content="Редактировать" Command="{Binding EditEventCommand}"/>
                <Button Content="Удалить" Command="{Binding DeleteEventCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <Label Content="Организация мероприятий"
               HorizontalAlignment="Left"
               Margin="240,55,0,0"
               VerticalAlignment="Top"
               FontFamily="Segoe UI Semibold"
               FontSize="24" Grid.ColumnSpan="2"/>
        <Calendar Grid.Column="0"
                  Margin="-24,95,232,0"
                  VerticalAlignment="Top"
                  SelectedDate="{Binding SelectedEvent.Date, Mode=TwoWay}" Height="181"/>

        <DataGrid
                  Grid.Column="0"
                  Margin="31,271,59,149"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Events}"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                  RowDetailsVisibilityMode="VisibleWhenSelected">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay}" />
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, Mode=TwoWay}" />
                <DataGridTextColumn Header="Участники" Binding="{Binding Participants.Count, Mode=OneWay}" />
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"/>
                            <TextBlock Text="{Binding Participants.Count, StringFormat='Участников: {0}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

        </DataGrid>

        <Button Content="Добавить мероприятие"
                HorizontalAlignment="Left"
                Margin="31,421,0,0"
                VerticalAlignment="Top"
                Height="20" Width="134"
                Command="{Binding CreateEventCommand}"/>

        <Button Content="Удалить мероприятие"
                HorizontalAlignment="Left"
                Margin="31,446,0,0"
                VerticalAlignment="Top"
                Width="134" Height="20"
                Command="{Binding DeleteEventCommand}"/>

        <Label Content="Регистрация"
               HorizontalAlignment="Center"
               Margin="0,90,0,0"
               VerticalAlignment="Top" Grid.Column="1"/>
        <StackPanel Grid.Column="1" Margin="19,120,215,0">

            <TextBlock Text="ФИО" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox
        Text="{Binding NewParticipant.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Margin="0,0,0,10"/>

            <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox
        Text="{Binding NewParticipant.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Margin="0,0,0,10"/>

            <TextBlock Text="Секция" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox
        Text="{Binding NewParticipant.Section, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Margin="0,0,0,10"/>

        </StackPanel>


        <ListBox
                 Margin="275,138,20,296"
                 Grid.Column="1"
                 ItemsSource="{Binding SelectedEvent.Participants}"/>

        <Button Content="Добавить участника"
                Template="{StaticResource RegisterButtonTemplate}"
                HorizontalAlignment="Left"
                Margin="173,290,0,0"
                VerticalAlignment="Top"
                Grid.Column="1" Height="35" Width="160"
                Command="{Binding RegisterCommand}"/>

        <StackPanel Grid.Column="1" Margin="19,330,10,10">

            <TextBlock Text="Чат" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <ListBox ItemsSource="{Binding ChatMessages}"
             Height="120"
             Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBox Width="200"
                 Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Отправить"
                Width="80"
                Margin="5,0,0,0"
                Command="{Binding SendChatCommand}"/>
            </StackPanel>

        </StackPanel>


    </Grid>
</Window>
