<Window x:Class="_12_pract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_12_pract"
        mc:Ignorable="d"
        Title="Организация мероприятий" Height="500" Width="800">
    
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateEventCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditEventCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DeleteEventCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <ControlTemplate x:Key="RegisterButtonTemplate" TargetType="Button">
            <Border Background="#4CAF50" CornerRadius="5" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👤" FontSize="16" Margin="0,0,5,0"/>
                    <ContentPresenter/>
                </StackPanel>
            </Border>
        </ControlTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="413*"/>
            <ColumnDefinition Width="387*"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="2" VerticalAlignment="Top">
            <MenuItem Header="Файл" />
            <MenuItem Header="Мероприятия">
                <MenuItem Header="Создать" Command="{Binding CreateEventCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать" Command="{Binding EditEventCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteEventCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="Участники" />
            <MenuItem Header="Настройки" />
        </Menu>

        <ToolBarTray Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,25,0,0">
            <ToolBar>
                <Button Content="Создать" Command="{Binding CreateEventCommand}"/>
                <Button Content="Редактировать" Command="{Binding EditEventCommand}"/>
                <Button Content="Удалить" Command="{Binding DeleteEventCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <Label Content="Организация мероприятий"
               HorizontalAlignment="Left"
               Margin="240,55,0,0"
               VerticalAlignment="Top"
               FontFamily="Segoe UI Semibold"
               FontSize="24" Grid.ColumnSpan="2"/>

        <DataGrid x:Name="EventsGrid"
                  AutoGenerateColumns="False"
                  SelectionChanged="DataGrid_SelectionChanged"
                  Margin="20,100,70,195"
                  RowDetailsVisibilityMode="VisibleWhenSelected">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay}" />
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, Mode=TwoWay}" />
                <DataGridTextColumn Header="Участники" Binding="{Binding ParticipantsCount, Mode=OneWay}" />
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"/>
                            <TextBlock Text="{Binding ParticipantsCount, StringFormat='Участников: {0}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

        </DataGrid>

        <Button Content="Добавить мероприятие"
                HorizontalAlignment="Left"
                Margin="20,305,0,0"
                VerticalAlignment="Top"
                Click="Button_Click" Height="20" Width="134"/>

        <Button Content="Удалить мероприятие"
                HorizontalAlignment="Left"
                Margin="20,339,0,0"
                VerticalAlignment="Top"
                Width="134" Height="20"
                Command="{Binding DeleteEventCommand}"/>

        <Label Content="Регистрация"
               HorizontalAlignment="Center"
               Margin="0,90,0,0"
               VerticalAlignment="Top" Grid.Column="1"/>

        <TextBox x:Name="NameBox"
                 Text="ФИО"
                 Margin="19,130,215,289"
                 GotFocus="TextBox_GotFocus"
                 LostFocus="TextBox_LostFocus"
                 Grid.Column="1"/>

        <TextBox x:Name="EmailBox"
                 Text="Email"
                 Margin="19,160,215,266"
                 GotFocus="TextBox_GotFocus"
                 LostFocus="TextBox_LostFocus"
                 Grid.Column="1"/>

        <TextBox x:Name="SectionBox"
                 Text="Секция"
                 Margin="19,190,215,242"
                 GotFocus="TextBox_GotFocus"
                 LostFocus="TextBox_LostFocus"
                 Grid.Column="1"/>

        <ListBox x:Name="ParticipantsList"
                 Margin="177,130,10,242"
                 Grid.Column="1"/>

        <Button Content="Добавить участника"
                Template="{StaticResource RegisterButtonTemplate}"
                HorizontalAlignment="Left"
                Margin="95,275,0,0"
                VerticalAlignment="Top"
                Click="AddParticipant_Click"
                Grid.Column="1" Height="35" Width="160"/>

    </Grid>
</Window>
